{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Registered administrator for CLB 2181 Society cash management.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth user ID of the admin."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email of the admin user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via serverTimestamp."
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Cash In or Cash Out financial transaction record for CLB 2181 Society.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["CASH_IN", "CASH_OUT"],
          "description": "Type of cash entry: CASH_IN or CASH_OUT."
        },
        "date": {
          "type": "string",
          "description": "Transaction date in YYYY-MM-DD or display format."
        },
        "amount": {
          "type": "number",
          "description": "Amount in currency (e.g. PKR/USD/INR)."
        },
        "description": {
          "type": "string",
          "description": "Description of cash received or spent."
        },
        "hasReceipt": {
          "type": "boolean",
          "description": "Whether a receipt or bill attachment exists."
        },
        "receiptFileName": {
          "type": "string",
          "description": "File name of uploaded receipt."
        },
        "receiptMimeType": {
          "type": "string",
          "description": "MIME type (image/jpeg, image/png, application/pdf)."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of admin who created the transaction."
        },
        "createdByEmail": {
          "type": "string",
          "description": "Email of creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via serverTimestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via serverTimestamp."
        }
      },
      "required": ["type", "date", "amount", "description", "hasReceipt", "createdBy", "createdAt"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Uploaded bill, slip, or receipt attachment in persistent storage.",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "description": "ID of associated transaction."
        },
        "fileName": {
          "type": "string",
          "description": "Name of uploaded file."
        },
        "mimeType": {
          "type": "string",
          "description": "File MIME type."
        },
        "base64Data": {
          "type": "string",
          "description": "Base64 encoded payload of image or PDF."
        },
        "uploadedBy": {
          "type": "string",
          "description": "User ID of uploader."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp via serverTimestamp."
        }
      },
      "required": ["transactionId", "fileName", "mimeType", "base64Data", "uploadedBy", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Collection of authorized administrators."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Cash In and Cash Out transactions for CLB 2181 Society."
    },
    "/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "Receipt documents storing images and PDFs."
    }
  }
}
